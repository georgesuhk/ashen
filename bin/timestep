#!/usr/bin/env python3
"""Simulation time at one or two restart steps, in SI seconds and JOREK's
own code units.

Same bootstrap as ``bin/run_jorek`` -- see that file's docstring. Library
modules must never touch ``sys.path`` themselves.
"""

from __future__ import annotations

import sys
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parents[1] / "src"))

from ashen.cli.timestep import main  # noqa: E402  (import follows bootstrap)

if __name__ == "__main__":
    sys.exit(main())
